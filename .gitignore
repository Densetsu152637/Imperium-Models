__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
# Each model's training outputs and data live on the Hugging Face Hub, not in Git.
/models/*/outputs/
/models/*/checkpoints/
/models/*/data/
/models/*/weights/
/models/*/runs/
*.gguf
*.safetensors
/models/*/tools/
# Token-era training data cached for the NCM research; only the READMEs are tracked.
/archive/**
!/archive/**/
!/archive/**/README.md

# API keys live outside the repository (~/.emperor/.env); never commit a copy.
.env
.env.*
!.env.example
